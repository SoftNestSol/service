pipeline {
    agent any
        tools {
        jdk 'jdk21' // This name must match the JDK installation name used in Jenkins Global Tool Configuration
    }
    environment {
        // Removed FIREBASE_SECRET_PATH from here
        DOCKER_PASSWORD = credentials("docker_password")
        GITHUB_TOKEN = credentials("github_token")
    }

    stages {
        stage('Build & Test') {
            steps {
                sh './gradlew clean build'
            }
        }
        stage('Tag image') {
            steps {
                script {
                    sh([script: 'git fetch --tags', returnStdout: true]).trim() // Added --tags explicitly

                    def latestTag = sh([script: 'git tag | sort --version-sort | tail -1', returnStdout: true]).trim()
                    if (latestTag) {
                        def parts = latestTag.tokenize('.')
                        if (parts.size() == 3 && parts[0].isInteger() && parts[1].isInteger() && parts[2].isInteger()) {
                            def major = parts[0].toInteger()
                            def minor = parts[1].toInteger()
                            def patch = parts[2].toInteger()
                            env.IMAGE_TAG = "${major}.${minor + 1}.${patch}"
                        } else {
                            error("Could not parse latest tag: ${latestTag}. Please create an initial tag like '1.0.0'.")
                        }
                    } else {
                         error("No tags found. Please create an initial tag like '1.0.0'.")
                    }`````
                    echo "Calculated next image tag: ${env.IMAGE_TAG}"
                } // End script block

                sh "docker build -t raduc321/booking-img:${env.IMAGE_TAG} ."
                sh "docker login -u raduc321 -p ${DOCKER_PASSWORD_PSW}"
                sh "docker push raduc321/booking-img:${env.IMAGE_TAG}"
                sh "git tag ${env.IMAGE_TAG}"
                sh "git push https://${GITHUB_TOKEN}@github.com/SoftNestSol/service.git ${env.IMAGE_TAG}"
             }
        }


        stage('Run Containers') {
            steps {
                // This block seems correct - it uses withCredentials locally
                withCredentials([file(credentialsId: 'firebase_key', variable: 'FIREBASE_SECRET_PATH_LOCAL')]) {
                    // Using a different variable name 'FIREBASE_SECRET_PATH_LOCAL' to avoid any potential confusion
                    // Also quoting the value passed as env var to docker compose
                    sh """
                        IMAGE_TAG=${env.IMAGE_TAG} \\
                        FIREBASE_SECRET_PATH="${env.FIREBASE_SECRET_PATH_LOCAL}" \\
                        docker compose up -d booking mongo
                    """
                }
            }
        }

        stage('Integration Tests') {
     steps {
         withCredentials([file(credentialsId: 'firebase_key', variable: 'FIREBASE_SECRET_PATH')]) {

          
             echo "DEBUG: Running Gradle testIT task..."
             // Original command - Ensure Gradle receives the property
             sh """
                 ./gradlew testIT -Dfirebase.key.path="${env.FIREBASE_SECRET_PATH}" 
             """
             // Added -i for --info logging level in Gradle to potentially get more context
         }
     }
 }
    } 
} 