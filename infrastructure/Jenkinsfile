pipeline {
    agent any // Run on any available agent

    tools {
        jdk 'jdk21' // Ensure 'jdk21' is configured in Jenkins Global Tool Configuration
    }

    environment {
        // Reverted: Define credentials directly for automatic _PSW/_USR or direct injection
        // Jenkins automatically provides DOCKER_PASSWORD_PSW for Username/Password credentials.
        // Jenkins injects the secret directly into GITHUB_TOKEN for Secret Text credentials.
        DOCKER_PASSWORD = credentials('docker_password')
        // !! IMPORTANT !! This assumes 'github_token' is a 'Secret Text' credential.
        // If it's 'Username/Password', this direct usage will fail differently or not work as expected.
        GITHUB_TOKEN = credentials('github_token')

        // Keep other environment variables for clarity
        FIREBASE_CREDENTIAL_ID = 'firebase_key'  // Credential ID for Firebase key
        DOCKER_USERNAME = 'raduc321'             // Docker username
        DOCKER_REGISTRY = 'raduc321'             // Docker registry/user for image name
        APP_NAME = 'booking-img'                 // Application/Image name
        GIT_REPO_URL_BASE = 'github.com/SoftNestSol/service.git' // Base Git repo URL path
    }

    stages {
        stage('Build') {
            steps {
                echo "Building the application..."
                sh './gradlew clean build'
            }
        }

        stage('Calculate Next Tag') {
            steps {
                script {
                    echo "Calculating next image tag..."
                    sh 'git fetch --tags' // Fetch tags to ensure latest are considered
                    def latestTag = sh(script: 'git tag | sort --version-sort | tail -1', returnStdout: true).trim()
                    if (latestTag =~ /^\d+\.\d+\.\d+$/) { // Basic validation for X.Y.Z format
                        def parts = latestTag.tokenize('.')
                        def major = parts[0].toInteger()
                        def minor = parts[1].toInteger()
                        def patch = parts[2].toInteger()
                        // Example: Increment minor version. Adjust logic as needed.
                        env.IMAGE_TAG = "${major}.${minor + 1}.${patch}"
                        echo "Latest tag found: ${latestTag}. Next tag: ${env.IMAGE_TAG}"
                    } else if (latestTag) {
                        error("Could not parse latest tag ('${latestTag}') as X.Y.Z. Please check tag format.")
                    } else {
                        env.IMAGE_TAG = '1.0.0' // Initial version if no tags found
                        echo "No previous tags found. Starting with initial tag: ${env.IMAGE_TAG}"
                    }
                }
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                script {
                    def imageName = "${env.DOCKER_REGISTRY}/${env.APP_NAME}:${env.IMAGE_TAG}"
                    echo "Building Docker image: ${imageName}"
                    sh "docker build -t ${imageName} ."

                    echo "Logging into Docker Hub..."
                    // Reverted: Using password directly in command (triggers warnings)
                    // Assumes DOCKER_PASSWORD = credentials(...) provides DOCKER_PASSWORD_PSW
                    sh "docker login -u ${env.DOCKER_USERNAME} -p ${DOCKER_PASSWORD_PSW}"

                    echo "Pushing Docker image: ${imageName}"
                    sh "docker push ${imageName}"

                    echo "Tagging Git commit with ${env.IMAGE_TAG}"
                    sh "git tag ${env.IMAGE_TAG}"

                    echo "Pushing Git tag ${env.IMAGE_TAG}"
                    // Reverted: Using token directly in URL (triggers warnings, assumes GITHUB_TOKEN is secret text)
                    // If GITHUB_TOKEN credential is Username/Password, this will likely fail.
                    // Using SSH keys is strongly recommended for Git push from CI.
                    sh "git push https://${GITHUB_TOKEN}@${env.GIT_REPO_URL_BASE} ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Deploy to Staging (Run Containers)') {
            steps {
                echo "Deploying containers using Docker Compose..."
                withCredentials([file(credentialsId: env.FIREBASE_CREDENTIAL_ID, variable: 'FIREBASE_SECRET_PATH_TMP')]) {
                    sh """
                        IMAGE_TAG=${env.IMAGE_TAG} \\
                        FIREBASE_SECRET_PATH="${env.FIREBASE_SECRET_PATH_TMP}" \\
                        docker compose up -d booking mongo
                    """
                }
            }
        }

        stage('Integration Tests') {
            steps {
                echo "Running Integration Tests..."
                withCredentials([file(credentialsId: env.FIREBASE_CREDENTIAL_ID, variable: 'FIREBASE_SECRET_PATH_TMP')]) {
                    // Keep chmod fix: Ensure the secret file is readable by the Gradle test process.
                    echo "Adjusting permissions for Firebase key file..."
                    sh 'chmod o+r "${env.FIREBASE_SECRET_PATH_TMP}"'
                    sh 'ls -la "${env.FIREBASE_SECRET_PATH_TMP}"' // Log permissions after change

                    echo "Executing Gradle testIT task..."
                    // Pass the path to the Firebase key as a system property
                    sh """
                        ./gradlew testIT -Dfirebase.key.path="${env.FIREBASE_SECRET_PATH_TMP}"
                    """
                }
            }
        }
    } // End stages

    post {
        always {
            echo 'Pipeline finished.'
            // Consider adding 'docker compose down' here if needed
        }
        success {
            echo 'Pipeline succeeded!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    } // End post
} // End pipeline