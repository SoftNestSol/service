pipeline {
    agent any // Run on any available agent

    tools {
        jdk 'jdk21' // Ensure 'jdk21' is configured in Jenkins Global Tool Configuration
    }

    environment {
        // Define credentials that need to be accessed as environment variables
        // Note: Jenkins automatically provides VAR_USR and VAR_PSW for Username/Password credentials
        // matching the environment variable name.
        // Using lowercase credential IDs is common practice.
        DOCKER_CREDENTIAL_ID = 'docker_password' // Store credential ID for reuse
        GITHUB_CREDENTIAL_ID = 'github_token'    // Store credential ID for reuse
        FIREBASE_CREDENTIAL_ID = 'firebase_key'  // Store credential ID for reuse
        DOCKER_USERNAME = 'raduc321'             // Docker username
        DOCKER_REGISTRY = 'raduc321'             // Docker registry/user for image name
        APP_NAME = 'booking-img'                 // Application/Image name
        GIT_REPO_URL = 'https://github.com/SoftNestSol/service.git' // Git repo URL
    }

    stages {
        stage('Build') {
            steps {
                echo "Building the application..."
                sh './gradlew clean build'
            }
        }

        stage('Calculate Next Tag') {
            steps {
                script {
                    echo "Calculating next image tag..."
                    sh 'git fetch --tags' // Fetch tags to ensure latest are considered
                    def latestTag = sh(script: 'git tag | sort --version-sort | tail -1', returnStdout: true).trim()
                    if (latestTag =~ /^\d+\.\d+\.\d+$/) { // Basic validation for X.Y.Z format
                        def parts = latestTag.tokenize('.')
                        def major = parts[0].toInteger()
                        def minor = parts[1].toInteger()
                        def patch = parts[2].toInteger()
                        // Example: Increment minor version. Adjust logic as needed (e.g., increment patch).
                        env.IMAGE_TAG = "${major}.${minor + 1}.${patch}"
                        echo "Latest tag found: ${latestTag}. Next tag: ${env.IMAGE_TAG}"
                    } else if (latestTag) {
                        error("Could not parse latest tag ('${latestTag}') as X.Y.Z. Please check tag format.")
                    } else {
                        // If no tags exist, start with an initial version
                        env.IMAGE_TAG = '1.0.0'
                        echo "No previous tags found. Starting with initial tag: ${env.IMAGE_TAG}"
                        // Optionally: error("No tags found. Please create an initial tag like '1.0.0'.")
                    }
                }
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                script {
                    def imageName = "${env.DOCKER_REGISTRY}/${env.APP_NAME}:${env.IMAGE_TAG}"
                    echo "Building Docker image: ${imageName}"
                    sh "docker build -t ${imageName} ."

                    echo "Logging into Docker Hub..."
                    // Securely login using credentials plugin and password via stdin
                    withCredentials([usernamePassword(credentialsId: env.DOCKER_CREDENTIAL_ID, usernameVariable: 'DOCKER_USER_VAR', passwordVariable: 'DOCKER_PASSWORD_VAR')]) {
                         // Check if username from credential matches expected, otherwise use hardcoded one
                         def loginUser = env.DOCKER_USER_VAR ?: env.DOCKER_USERNAME
                         sh """
                            echo '${env.DOCKER_PASSWORD_VAR}' | docker login -u '${loginUser}' --password-stdin
                         """
                    }

                    echo "Pushing Docker image: ${imageName}"
                    sh "docker push ${imageName}"

                    echo "Tagging Git commit with ${env.IMAGE_TAG}"
                    sh "git tag ${env.IMAGE_TAG}"

                    echo "Pushing Git tag ${env.IMAGE_TAG}"
                    // Pushing tags securely: Using SSH keys is preferred.
                    // This HTTPS method still embeds the token in the command process, though better than direct URL.
                    // Consider using plugins like 'Credentials Binding' + git command if more security needed.
                    withCredentials([string(credentialsId: env.GITHUB_CREDENTIAL_ID, variable: 'GITHUB_TOKEN_VAR')]) {
                        // Use a credential helper approach (more complex but securest for https)
                        // sh """
                        // git -c credential.helper='!f() { echo password=\\$GITHUB_TOKEN_VAR; }; f' push ${env.GIT_REPO_URL} ${env.IMAGE_TAG}
                        // """
                        // Or simpler (but less secure) direct URL method within credentials scope:
                        sh "git push https://${env.GITHUB_TOKEN_VAR}@github.com/${env.GIT_REPO_URL.split('/').minus('https:').minus('').join('/')} ${env.IMAGE_TAG}"
                    }
                }
            }
        }

        stage('Deploy to Staging (Run Containers)') {
            steps {
                echo "Deploying containers using Docker Compose..."
                // Use credentials for the Firebase key file path
                withCredentials([file(credentialsId: env.FIREBASE_CREDENTIAL_ID, variable: 'FIREBASE_SECRET_PATH_TMP')]) {
                    // Pass necessary info as environment variables to docker compose command
                    sh """
                        IMAGE_TAG=${env.IMAGE_TAG} \\
                        FIREBASE_SECRET_PATH="${env.FIREBASE_SECRET_PATH_TMP}" \\
                        docker compose up -d booking mongo
                    """
                    // Ensure your docker-compose.yml correctly uses these environment variables
                    // e.g., image: ${DOCKER_REGISTRY}/${APP_NAME}:${IMAGE_TAG}
                    // e.g., environment: - FIREBASE_SECRET_PATH=${FIREBASE_SECRET_PATH} (if app needs var)
                    // or volumes: - ${FIREBASE_SECRET_PATH}:/path/inside/container/firebase-key.json (if app needs file)
                }
            }
        }

        stage('Integration Tests') {
            steps {
                echo "Running Integration Tests..."
                withCredentials([file(credentialsId: env.FIREBASE_CREDENTIAL_ID, variable: 'FIREBASE_SECRET_PATH_TMP')]) {
                    // Ensure the secret file is readable by the user running the Gradle test process.
                    // This might be necessary if Jenkins creates the file with restricted permissions (e.g., root-only).
                    // Remove if tests run fine without it in your specific agent environment.
                    echo "Adjusting permissions for Firebase key file..."
                    sh 'chmod o+r "${env.FIREBASE_SECRET_PATH_TMP}"'
                    sh 'ls -la "${env.FIREBASE_SECRET_PATH_TMP}"' // Log permissions after change

                    echo "Executing Gradle testIT task..."
                    // Pass the path to the Firebase key as a system property to the Gradle test JVM
                    sh """
                        ./gradlew testIT -Dfirebase.key.path="${env.FIREBASE_SECRET_PATH_TMP}"
                    """
                }
            }
        }
    } // End stages

    post {
        always {
            // Clean up workspace, notify, etc.
            echo 'Pipeline finished.'
            // Clean up docker-compose environment if needed
            // sh 'docker compose down --remove-orphans'
        }
        success {
            echo 'Pipeline succeeded!'
            // Potentially notify success channel
        }
        failure {
            echo 'Pipeline failed!'
            // Potentially notify failure channel
        }
    } // End post
} // End pipeline